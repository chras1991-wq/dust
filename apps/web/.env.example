# Copy to apps/web/.env.local for local dev — never commit .env.local
# Production: set the same keys in Vercel → Project → Settings → Environment Variables only.

# Server-only (required in production)
QUOTE_SECRET=replace-with-long-random-secret-at-least-32-chars
ADMIN_TOKEN=replace-with-admin-token-at-least-16-chars
PROJECT_ADDRESS=bc1-your-mint-payee-here
SWAP_POOL_ADDRESS=bc1-your-swap-pool-here

DEPLOY_TXID=
DEPLOY_INSCRIPTION_ID=
BTC_USD_FALLBACK=100000
MOCK_MINTED=0
MOCK_PENDING=0
NETWORK=mainnet

# Client (set in Vercel for production builds)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Shared mint state (Vercel KV / Upstash — production)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
