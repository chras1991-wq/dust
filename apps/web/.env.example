# Server-only — never prefix with NEXT_PUBLIC_
QUOTE_SECRET=replace-with-long-random-secret-at-least-32-chars
ADMIN_TOKEN=replace-with-admin-token-at-least-16-chars

DEPLOY_TXID=
DEPLOY_INSCRIPTION_ID=
BTC_USD_FALLBACK=100000
MOCK_MINTED=0
MOCK_PENDING=0
NETWORK=mainnet

# Public site URL only (safe for client metadata)
NEXT_PUBLIC_SITE_URL=https://dust20.com

# Shared mint state (required for multi-instance / high traffic on Vercel)
# Create Upstash Redis or Vercel KV and paste REST credentials:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
